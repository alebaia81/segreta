# ─────────────────────────────────────────────────────────────────────────────
# public/_headers — Segreta Style
# Cloudflare Pages HTTP Response Headers
#
# Sintassi: https://developers.cloudflare.com/pages/configuration/headers/
# Questo file viene distribuito nella root di dist/ da Vite e letto da CF Pages.
# ─────────────────────────────────────────────────────────────────────────────

# ── 1. index.html — sempre fresco (no cache) ─────────────────────────────────
/index.html
  Cache-Control: no-cache, no-store, must-revalidate
  Pragma: no-cache
  Expires: 0
  X-Content-Type-Options: nosniff
  X-Frame-Options: SAMEORIGIN
  Referrer-Policy: strict-origin-when-cross-origin
  Permissions-Policy: camera=(), microphone=(), geolocation=()

# ── 2. Tutti gli URL (fallback SPA routing) ───────────────────────────────────
/*
  X-Content-Type-Options: nosniff
  X-Frame-Options: SAMEORIGIN
  X-XSS-Protection: 1; mode=block
  Referrer-Policy: strict-origin-when-cross-origin
  Permissions-Policy: camera=(), microphone=(), geolocation=()
  # CSP bilanciato per glassmorphism + Framer Motion + Google Fonts
  Content-Security-Policy: default-src 'self'; script-src 'self' 'unsafe-inline' https://www.paypal.com https://www.sandbox.paypal.com https://www.paypalobjects.com; style-src 'self' 'unsafe-inline' https://fonts.googleapis.com; font-src 'self' https://fonts.gstatic.com; img-src 'self' data: https:; frame-src 'self' https://www.google.com https://www.paypal.com https://www.sandbox.paypal.com; connect-src 'self' https://www.paypal.com https://www.sandbox.paypal.com https://*.paypal.com https://*.paypalobjects.com; worker-src 'none'

# ── 3. Asset hashati Vite (/assets/*) — cache immutable 1 anno ───────────────
# I nomi file includono il hash del contenuto (es. index-Abc123.js).
# Non serve MAI purge: file diversi = URL diversi.
/assets/*
  Cache-Control: public, max-age=31536000, immutable
  X-Content-Type-Options: nosniff

# ── 4. Immagini statiche senza hash — cache 1 giorno + stale-while-revalidate ─
# Queste vengono purgiate dalla pipeline CI/CD a ogni deploy.
/greta.jpg
  Cache-Control: public, max-age=86400, stale-while-revalidate=3600

/logo.png
  Cache-Control: public, max-age=86400, stale-while-revalidate=3600

/boutique_bg.png
  Cache-Control: public, max-age=86400, stale-while-revalidate=3600

/favicon.svg
  Cache-Control: public, max-age=604800, stale-while-revalidate=86400

# ── 5. API routes — nessuna cache ────────────────────────────────────────────
/api/*
  Cache-Control: no-store, no-cache
  Pragma: no-cache
